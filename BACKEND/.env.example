# Servidor
PORT=3000

# Base de datos
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/matrimonio?schema=public"

# JWT
TOKEN_SECRET=cambia_esto
TOKEN_EXPIRES=7d

# URL del front donde se abre la invitacion (link personalizado = FRONTEND_URL/invitacion/<uuid>)
FRONTEND_URL=http://localhost:3000

# Carpeta del front que sirve Express (/, /invitacion/:uuid, /admin). Vacio = solo API
FRONT_DIR="../Matrimonio-Tarjeta de presentacion"

# Codigo de pais para links de WhatsApp (Colombia = 57)
COUNTRY_CODE=57

# Admin inicial (npm run seed)
ADMIN_NAME=Welinton
ADMIN_EMAIL=admin@matrimonio.com
ADMIN_PASSWORD=cambia_esto
